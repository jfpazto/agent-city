{
  "name": "ciudad-de-agentes",
  "private": true,
  "license": "MIT",
  "author": "Jonathan Paez",
  "repository": "github:jfpazto/agent-city",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n collector,web -c green,blue \"npm run dev -w @ciudad/collector\" \"npm run dev -w @ciudad/web\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "hooks:install": "tsx packages/collector/scripts/hooks.ts install",
    "hooks:uninstall": "tsx packages/collector/scripts/hooks.ts uninstall",
    "hooks:install:codex": "tsx packages/collector/scripts/hooks.ts install codex",
    "hooks:uninstall:codex": "tsx packages/collector/scripts/hooks.ts uninstall codex",
    "autostart:install": "node scripts/autostart.mjs install",
    "autostart:uninstall": "node scripts/autostart.mjs uninstall",
    "autostart:status": "node scripts/autostart.mjs status",
    "dev:web": "npm run dev -w @ciudad/web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
